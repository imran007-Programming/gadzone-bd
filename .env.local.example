# GadZone BD — Google login (NextAuth) setup
# Copy this file to .env.local and fill in YOUR OWN values.
# Never commit real secrets to GitHub.

# Google OAuth — get these from Google Cloud Console (APIs & Services → Credentials → OAuth client ID).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (and your production URL + /api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth secret — generate with: openssl rand -base64 32
# (AUTH_SECRET is the Auth.js v5 name; NEXTAUTH_SECRET also works.)
AUTH_SECRET=
NEXTAUTH_SECRET=

# Full site URL (local dev / production)
NEXTAUTH_URL=http://localhost:3000

# Admin accounts — comma-separated Google emails that get the "admin" role
# Example: ADMIN_EMAILS=you@example.com,other@example.com
ADMIN_EMAILS=
